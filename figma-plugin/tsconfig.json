// The plugin's main thread, which holds the file: Figma's API, no DOM.
{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": [
      "@figma/plugin-typings"
    ],
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/ui.ts",
    "src/activity.ts"
  ]
}
